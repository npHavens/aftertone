FRONTEND_ORIGIN=http://127.0.0.1:3000
SPOTIFY_REDIRECT_URI=http://127.0.0.1:3000/api/auth/spotify/callback
SPOTIFY_CLIENT_ID=
# Generate with: uv run python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
TOKEN_ENCRYPTION_KEY=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY_PATH=
GOOGLE_CLOUD_PROJECT=nhs-aftertone
# Keeps Vertex quota and billing on this project when the ADC quota project points elsewhere.
GOOGLE_CLOUD_QUOTA_PROJECT=nhs-aftertone
GOOGLE_CLOUD_LOCATION=global
GEMINI_MODEL=gemini-4-argon
# Only enable after verifying project ownership, billing, region and model access.
VERTEX_ACCESS_VERIFIED=false
STORE_PATH=.local/aftertone.sqlite3
SESSION_TTL_SECONDS=86400
